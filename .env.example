# Copy to .env. This application runs synthetic workflows only.
DEMO_MODE=true
DATABASE_URL=postgresql://careloop:careloop@127.0.0.1:54329/careloop
DATABASE_URL_UNPOOLED=postgresql://careloop:careloop@127.0.0.1:54329/careloop
# For Neon, set the pooled runtime and direct migration URL from the SAME branch.
# The legacy DATABASE_URL_UNPOOLED alias is supported; remove its local default
# when configuring Neon. Both direct settings, if present, must select the runtime target.
# DATABASE_URL=postgresql://<runtime-role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=verify-full
# DATABASE_DIRECT_URL=postgresql://<migration-role>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=verify-full
DATABASE_ENVIRONMENT=development
DATABASE_POOL_MAX=10
# Optional restricted runtime role; generated privately by db:provision-runtime.
# DATABASE_RUNTIME_URL=
SESSION_SECRET=local-synthetic-only-change-before-any-shared-demo-2026
WORKER_SECRET=local-synthetic-worker-secret-2026
APP_ORIGIN=http://localhost:3001
API_PORT=4001
API_HOST=127.0.0.1
ML_URL=http://127.0.0.1:8001
ML_INTERNAL_KEY=local-synthetic-ml-key-2026-minimum32
OUTBOUND_PROVIDER=simulated
DATA_RETENTION_DAYS=90

# Clerk identity (development keys are written privately by Clerk CLI to apps/web/.env.local).
# Leave these unset when Clerk CLI owns apps/web/.env.local. Empty root values
# would otherwise override the keys pulled there.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET=
# Optional expected issuer; otherwise derived from the configured publishable key.
# CLERK_ISSUER_URL=
DEFAULT_ORGANIZATION_ID=org-screening
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Optional private medical documents. Configure a dedicated bucket with public
# access blocked and scoped server credentials. Without all required settings,
# metadata remains readable but uploads/downloads return a sanitized 503.
# DOCUMENT_STORAGE_PRIVATE=true
# DOCUMENT_STORAGE_BUCKET=
# DOCUMENT_STORAGE_REGION=
# DOCUMENT_STORAGE_ACCESS_KEY_ID=
# DOCUMENT_STORAGE_SECRET_ACCESS_KEY=
# Optional S3-compatible HTTPS endpoint; omit for Amazon S3.
# DOCUMENT_STORAGE_ENDPOINT=

# Neon private storage uses the AWS_* variables managed by `neon deploy`.
# DOCUMENT_STORAGE_PROVIDER=neon
# DOCUMENT_STORAGE_PRIVATE=true
# DOCUMENT_STORAGE_BUCKET=careloop-medical-documents
# AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# are server-only credentials. Do not put them into NEXT_PUBLIC_* settings.
